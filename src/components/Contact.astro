  /* Success Overlay */
  .success-overlay {
    display: none;
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.98);
    backdrop-filter: blur(10px);
    border-radius: var(--radius-xl);
    z-index: 15;
    align-items: center;
    justify-content: center;
    min-height: 400px;
  }
  
  .success-overlay.show {
    display: flex;
    animation: overlay-fade-in 0.4s ease-out;
  }
  
  @keyframes overlay-fade-in {
