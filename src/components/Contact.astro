---
// Contact Section - Adapted from Stitch design
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<section class="contact section" id="contact">
  <div class="container">
    <div class="contact-grid">
      <!-- Left Column: Info -->
      <div class="contact-info reveal-left">
        <div class="contact-header-row">
          <div class="contact-badge">{t(lang, 'contact.badge')}</div>
          <div class="available-status">
            <span class="status-dot"></span>
            <span>{lang === 'es' ? 'Disponible' : 'Available'}</span>
          </div>
        </div>
        <h2 class="contact-title">{t(lang, 'contact.title')} <span class="gradient-text">{t(lang, 'contact.title_highlight')}</span></h2>
        <p class="contact-description">
          {t(lang, 'contact.description')}
        </p>
        
        <!-- Contact Details -->
        <div class="contact-details">
          <div class="detail-item">
            <div class="detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div class="detail-content">
              <span class="detail-label">{t(lang, 'contact.info.email_label')}</span>
              <a href="mailto:contactos.ronald2209@gmail.com" class="detail-value">contactos.ronald2209@gmail.com</a>
            </div>
          </div>
          
          <div class="detail-item">
            <div class="detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div class="detail-content">
              <span class="detail-label">{t(lang, 'contact.info.phone_label')}</span>
              <a href="tel:+51992311691" class="detail-value">+51 992 311 691</a>
            </div>
          </div>
          
          <div class="detail-item">
            <div class="detail-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div class="detail-content">
              <span class="detail-label">{t(lang, 'contact.info.location_label')}</span>
              <span class="detail-value">{t(lang, 'contact.info.location')}</span>
            </div>
          </div>
        </div>

        <!-- Social Links -->
        <div class="social-section">
          <span class="social-label">{lang === 'es' ? 'También en' : 'Also on'}</span>
          <div class="social-buttons">
            <a href="https://github.com/RonaldDM" target="_blank" rel="noopener noreferrer" class="social-btn" title="GitHub" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
            <a href="https://linkedin.com/in/ronalddm2209" target="_blank" rel="noopener noreferrer" class="social-btn" title="LinkedIn" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
      <!-- Right Column: Form -->
      <div class="contact-form-wrapper reveal-right" id="form-wrapper">
        <div class="form-glow"></div>
        
        <!-- Success Overlay with Blur -->
        <div class="success-overlay" id="success-overlay">
          <div class="success-content">
            <div class="check-circle">
              <svg class="check-svg" viewBox="0 0 52 52">
                <circle class="check-circle-bg" cx="26" cy="26" r="25" fill="none"/>
                <circle class="check-circle-line" cx="26" cy="26" r="25" fill="none"/>
                <path class="check-mark" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
              </svg>
            </div>
            <h3 class="success-title">{lang === 'es' ? '¡Mensaje enviado!' : 'Message sent!'}</h3>
            <p class="success-text">{lang === 'es' ? 'Gracias por contactarme. Te responderé pronto.' : 'Thanks for reaching out. I\'ll get back to you soon.'}</p>
          </div>
        </div>
        
        <!-- Error Message -->
        <div class="form-status error" id="form-error">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="15" y1="9" x2="9" y2="15"/>
            <line x1="9" y1="9" x2="15" y2="15"/>
          </svg>
          <h3>{lang === 'es' ? 'Error al enviar' : 'Failed to send'}</h3>
          <p>{lang === 'es' ? 'Hubo un problema. Intenta de nuevo o escríbeme directamente.' : 'Something went wrong. Try again or email me directly.'}</p>
        </div>
        
        <form class="contact-form" id="contact-form" data-lang={lang}>
          <!-- Web3Forms Hidden Fields -->
          <input type="hidden" name="access_key" value={web3formsKey}>
          <input type="hidden" name="subject" value="Nuevo mensaje desde Portfolio - Ronald Davila">
          <input type="hidden" name="from_name" value="Portfolio Contact Form">
          <!-- Honeypot for spam protection -->
          <input type="checkbox" name="botcheck" class="hidden" style="display:none">

          <!-- Mobile Step Progress Banner (hidden on desktop) -->
          <div class="step-banner">
            <div class="step-banner-top">
              <span class="step-banner-counter" id="step-banner-counter">{lang === 'es' ? 'Paso 1 de 2' : 'Step 1 of 2'}</span>
              <span class="step-banner-name" id="step-banner-name">{lang === 'es' ? 'Sobre ti' : 'About you'}</span>
            </div>
            <div class="step-banner-bar">
              <div class="step-banner-fill" id="step-banner-fill" style="width: 50%"></div>
            </div>
          </div>

          <!-- Step Indicator -->
          <div class="step-indicator">
            <div class="step-item active" id="step-ind-1">
              <div class="step-num">1</div>
              <span class="step-label">{lang === 'es' ? 'Sobre ti' : 'About you'}</span>
            </div>
            <div class="step-track">
              <div class="step-track-fill" id="step-track-fill"></div>
            </div>
            <div class="step-item" id="step-ind-2">
              <div class="step-num">2</div>
              <span class="step-label">{lang === 'es' ? 'Tu mensaje' : 'Your message'}</span>
            </div>
          </div>

          <!-- Step 1: Identity + Inquiry type -->
          <div class="form-step" id="form-step-1">
            <div class="form-row">
              <div class="form-group">
                <label for="name">{t(lang, 'contact.form.name')}</label>
                <div class="input-wrapper">
                  <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                  </svg>
                  <input type="text" id="name" name="name" placeholder={t(lang, 'contact.form.name_placeholder')} required>
                </div>
              </div>
              <div class="form-group">
                <label for="email">{t(lang, 'contact.form.email')}</label>
                <div class="input-wrapper">
                  <svg class="input-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-3.92 7.94"/>
                  </svg>
                  <input type="email" id="email" name="email" placeholder={t(lang, 'contact.form.email_placeholder')} required>
                </div>
              </div>
            </div>

            <div class="form-group">
              <label>{lang === 'es' ? '¿En qué te puedo ayudar?' : 'How can I help you?'}</label>
              <input type="hidden" name="inquiry_type" id="inquiry_type" value={lang === 'es' ? 'Consulta de Proyecto' : 'Project Inquiry'}>
              <div class="inquiry-chips">
                <button type="button" class="inquiry-chip active" data-value={lang === 'es' ? 'Consulta de Proyecto' : 'Project Inquiry'}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <line x1="8" y1="21" x2="16" y2="21"/>
                    <line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                  {lang === 'es' ? 'Proyecto' : 'Project'}
                </button>
                <button type="button" class="inquiry-chip" data-value={lang === 'es' ? 'Oportunidad Laboral' : 'Job Opportunity'}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="7" width="20" height="14" rx="2"/>
                    <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
                  </svg>
                  {lang === 'es' ? 'Trabajo' : 'Job'}
                </button>
                <button type="button" class="inquiry-chip" data-value={lang === 'es' ? 'Colaboración' : 'Collaboration'}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                  {lang === 'es' ? 'Colaborar' : 'Collab'}
                </button>
                <button type="button" class="inquiry-chip" data-value={lang === 'es' ? 'Otro' : 'Other'}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                  {lang === 'es' ? 'Otro' : 'Other'}
                </button>
              </div>
            </div>

            <button type="button" class="btn btn-primary btn-next-step" id="step-next">
              {lang === 'es' ? 'Continuar' : 'Continue'}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>

          <!-- Step 2: Message + Submit -->
          <div class="form-step" id="form-step-2" style="display:none">
            <div class="form-group">
              <label for="message">{t(lang, 'contact.form.message')}</label>
              <textarea id="message" name="message" rows="6" placeholder={t(lang, 'contact.form.message_placeholder')} required></textarea>
            </div>

            <div class="step-actions">
              <button type="button" class="btn btn-ghost btn-back-step" id="step-back">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="19" y1="12" x2="5" y2="12"/>
                  <polyline points="12 19 5 12 12 5"/>
                </svg>
                {lang === 'es' ? 'Volver' : 'Back'}
              </button>
              <button type="submit" class="btn btn-primary btn-submit" id="submit-btn">
                <span class="btn-text">{t(lang, 'contact.form.submit')}</span>
                <span class="btn-loading">{lang === 'es' ? 'Enviando...' : 'Sending...'}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--color-dark);
  }
  
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  
  /* Left Column */
  .contact-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: rgba(13, 148, 136, 0.15);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: var(--radius-full);
    margin-bottom: 1.5rem;
  }
  
  .contact-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: var(--color-light);
  }
  
  .contact-description {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 400px;
    margin-bottom: 2.5rem;
  }
  
  /* Contact Details */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-dark-muted);
    margin-bottom: 2rem;
  }
  
  .detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  
  .detail-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-dark-soft);
    border-radius: var(--radius-lg);
    color: var(--color-primary);
    flex-shrink: 0;
  }
  
  .detail-label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  
  .detail-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-light);
    transition: color var(--transition-fast);
  }
  
  a.detail-value:hover {
    color: var(--color-primary);
  }
  
  /* Social Section */
  .social-section {
    padding-top: 1.5rem;
  }
  
  .social-label {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  
  .social-buttons {
    display: flex;
    gap: 0.75rem;
  }
  
  .social-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--color-dark-soft);
    border-radius: var(--radius-lg);
    color: var(--color-text);
    transition: all var(--transition-base);
  }
  
  .social-btn:hover {
    background: var(--color-primary);
    color: white;
    transform: translateY(-3px);
  }
  
  /* Right Column: Form */
  .contact-form-wrapper {
    background: var(--color-dark-soft);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    border: 1px solid var(--color-dark-muted);
    position: relative;
    overflow: hidden;
    min-height: 450px;
  }
  
  .form-glow {
    position: absolute;
    top: -100px;
    right: -100px;
    width: 250px;
    height: 250px;
    background: rgba(13, 148, 136, 0.08);
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }
  
  .contact-form {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .form-group label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-light);
  }
  
  .input-wrapper {
    position: relative;
  }
  
  .input-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }
  
  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    pointer-events: none;
  }
  
  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    background: var(--color-dark);
    border: 1px solid var(--color-dark-muted);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-family: inherit;
    font-size: 0.95rem;
    transition: all var(--transition-base);
  }
  
  .form-group input,
  .form-group select {
    padding-left: 2.75rem;
  }
  
  .form-group select {
    appearance: none;
    cursor: pointer;
    padding-right: 2.75rem;
  }
  
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
  }
  
  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-dark-muted);
  }
  
  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }
  
  .btn-submit {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
    margin-top: 0.5rem;
  }
  
  .btn-submit:hover svg {
    transform: translateX(3px);
  }
  
  .btn-submit svg {
    transition: transform var(--transition-base);
  }
  
  /* Available Status Badge */
  .contact-header-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .contact-header-row .contact-badge {
    margin-bottom: 0;
  }

  .available-status {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.8rem;
    background: rgba(39, 202, 64, 0.08);
    border: 1px solid rgba(39, 202, 64, 0.25);
    border-radius: var(--radius-full);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #27ca40;
    flex-shrink: 0;
    animation: status-pulse 2s infinite;
  }

  .available-status span:last-child {
    font-size: 0.68rem;
    font-weight: 700;
    color: #27ca40;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  @keyframes status-pulse {
    0%   { box-shadow: 0 0 0 0 rgba(39, 202, 64, 0.45); }
    70%  { box-shadow: 0 0 0 6px rgba(39, 202, 64, 0); }
    100% { box-shadow: 0 0 0 0 rgba(39, 202, 64, 0); }
  }

  /* Step Indicator */
  .step-indicator {
    display: flex;
    align-items: center;
    margin-bottom: 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-dark-muted);
  }

  .step-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid var(--color-dark-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-text-muted);
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .step-item.active .step-num {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: white;
  }

  .step-item.done .step-num {
    border-color: var(--color-primary);
    background: transparent;
    color: var(--color-primary);
  }

  .step-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
  }

  .step-item.active .step-label {
    color: var(--color-light);
    font-weight: 500;
  }

  .step-track {
    flex: 1;
    height: 2px;
    background: var(--color-dark-muted);
    margin: 0 0.75rem;
    border-radius: 1px;
    overflow: hidden;
  }

  .step-track-fill {
    height: 100%;
    width: 0%;
    background: var(--color-primary);
    transition: width 0.4s ease;
  }

  /* Inquiry Chips */
  .inquiry-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .inquiry-chip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-dark-muted);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    font-size: 0.82rem;
    font-family: inherit;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .inquiry-chip:hover {
    border-color: rgba(13, 148, 136, 0.5);
