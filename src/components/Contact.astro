  @keyframes confetti-explode {
    0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
    100% { opacity: 0; }
  }
  
  .success-icon {
    animation: success-pop 0.5s ease-out forwards;
  }
  
  .success-icon svg {
    color: var(--color-primary);
  }
  
  @keyframes success-pop {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); opacity: 1; }
  }
</style>

<script>
  // ─── Inquiry Chips ───────────────────────────────────────────────────
  const chips = document.querySelectorAll<HTMLButtonElement>('.inquiry-chip');
  const inquiryInput = document.getElementById('inquiry_type') as HTMLInputElement | null;

  chips.forEach(chip => {
    chip.addEventListener('click', () => {
      chips.forEach(c => c.classList.remove('active'));
      chip.classList.add('active');
      if (inquiryInput) inquiryInput.value = chip.dataset.value ?? '';
    });
  });

  // ─── Step Navigation ─────────────────────────────────────────────────
  const step1El = document.getElementById('form-step-1');
  const step2El = document.getElementById('form-step-2');
  const stepInd1 = document.getElementById('step-ind-1');
  const stepInd2 = document.getElementById('step-ind-2');
  const trackFill = document.getElementById('step-track-fill') as HTMLElement | null;
  const nextBtn = document.getElementById('step-next');
  const backBtn = document.getElementById('step-back');
  // Mobile banner
  const bannerCounter = document.getElementById('step-banner-counter') as HTMLElement | null;
  const bannerName = document.getElementById('step-banner-name') as HTMLElement | null;
  const bannerFill = document.getElementById('step-banner-fill') as HTMLElement | null;
  const formLang = (document.getElementById('contact-form') as HTMLFormElement | null)?.dataset?.lang ?? 'es';
  const isEs = formLang === 'es';

  function setStep(n: number): void {
    const show = n === 1 ? step1El : step2El;
    const hide = n === 1 ? step2El : step1El;
    if (hide) hide.style.display = 'none';
    if (show) show.style.display = '';

    stepInd1?.classList.toggle('active', n === 1);
    stepInd1?.classList.toggle('done', n > 1);
    stepInd2?.classList.toggle('active', n === 2);

    if (trackFill) trackFill.style.width = n > 1 ? '100%' : '0%';

    // Update mobile banner
    if (bannerCounter) bannerCounter.textContent = isEs ? `Paso ${n} de 2` : `Step ${n} of 2`;
    if (bannerName) bannerName.textContent = n === 1
      ? (isEs ? 'Sobre ti' : 'About you')
      : (isEs ? 'Tu mensaje' : 'Your message');
    if (bannerFill) bannerFill.style.width = n === 1 ? '50%' : '100%';
  }

  nextBtn?.addEventListener('click', () => {
    const nameInput = document.getElementById('name') as HTMLInputElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;

    if (!nameInput?.value.trim()) {
      nameInput?.focus();
      nameInput?.reportValidity();
      return;
    }
    if (!emailInput?.value.trim() || !emailInput.checkValidity()) {
      emailInput?.focus();
      emailInput?.reportValidity();
      return;
    }

    setStep(2);
    (document.getElementById('message') as HTMLTextAreaElement | null)?.focus();
  });

  backBtn?.addEventListener('click', () => setStep(1));

  // ─── Form Submission ─────────────────────────────────────────────────
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn');
  const errorDiv = document.getElementById('form-error');
  const overlay = document.getElementById('success-overlay');
  const formWrapper = document.getElementById('form-wrapper');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Guard: ensure step-1 fields are filled even if somehow bypassed
      const nameVal = (document.getElementById('name') as HTMLInputElement | null)?.value?.trim();
      const emailVal = (document.getElementById('email') as HTMLInputElement | null)?.value?.trim();
      if (!nameVal || !emailVal) {
        setStep(1);
        (document.getElementById('name') as HTMLInputElement | null)?.focus();
        return;
      }

      submitBtn?.classList.add('loading');

      try {
        const formData = new FormData(form);
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (result.success) {
          formWrapper?.classList.add('blur-active');
          overlay?.classList.add('show');
        } else {
          form.classList.add('hidden');
          errorDiv?.classList.add('show');
        }
      } catch {
        form.classList.add('hidden');
        errorDiv?.classList.add('show');
      } finally {
        submitBtn?.classList.remove('loading');
      }
    });
  }
</script>
