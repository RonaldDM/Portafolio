  /* Form Step */
  .form-step {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Step 2 bottom actions */
  .step-actions {
    display: flex;
    gap: 0.75rem;
  }

  .step-actions .btn-submit {
    flex: 1;
