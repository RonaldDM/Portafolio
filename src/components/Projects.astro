---
// Projects Section - Filterable grid with 6 projects
import { t, tArray, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;

// Project data: translations come from i18n, static data lives here
const projects = [
  {
    key: 'marketing',
    category: 'fullstack',
    type: 'professional',
    isPrivate: true,
    imagePlaceholderIcon: 'chart',
    tech: [
      { name: 'React', color: '#61DAFB' },
      { name: 'Node.js', color: '#5FA04E' },
      { name: 'Redis', color: '#FF4438' },
      { name: 'MySQL', color: '#4479A1' },
      { name: 'Playwright', color: '#2EAD33' },
    ],
    demo: null,
    code: null,
  },
  {
    key: 'desktop',
    category: 'desktop',
    type: 'professional',
    isPrivate: true,
    imagePlaceholderIcon: 'monitor',
    tech: [
      { name: 'Electron', color: '#47848F' },
      { name: 'Node.js', color: '#5FA04E' },
      { name: 'WebSockets', color: '#8b5cf6' },
      { name: 'Niubiz', color: '#0052CC' },
    ],
    demo: null,
    code: null,
  },
  {
    key: 'tracking',
    category: 'backend',
    type: 'professional',
    isPrivate: true,
    imagePlaceholderIcon: 'radar',
    tech: [
      { name: 'Node.js', color: '#5FA04E' },
      { name: 'MySQL', color: '#4479A1' },
      { name: 'UTM', color: '#0d9488' },
    ],
    demo: null,
    code: null,
  },
  {
    key: 'emails',
    category: 'backend',
    type: 'professional',
    isPrivate: true,
    imagePlaceholderIcon: 'mail',
    tech: [
      { name: 'AWS SES', color: '#FF9900' },
      { name: 'Mautic', color: '#4E5D9D' },
      { name: 'Docker', color: '#2496ED' },
      { name: 'Node.js', color: '#5FA04E' },
    ],
    demo: null,
    code: null,
  },
  {
    key: 'citas',
    category: 'backend',
    type: 'professional',
    isPrivate: true,
    imagePlaceholderIcon: 'calendar',
    tech: [
      { name: 'Node.js', color: '#5FA04E' },
      { name: 'MySQL', color: '#4479A1' },
    ],
    demo: null,
    code: null,
  },
  {
    key: 'restcabana',
    category: 'mobile',
    type: 'personal',
    isPrivate: false,
    imagePlaceholderIcon: null,
    image: '/screenshots/restcabana_ss1.jpg',
    tech: [
      { name: 'NestJS', color: '#E0234E' },
      { name: 'React Native', color: '#61DAFB' },
      { name: 'TypeScript', color: '#3178C6' },
      { name: 'MySQL', color: '#4479A1' },
      { name: 'Firebase', color: '#DD2C00' },
    ],
    demo: 'https://github.com/RonaldDM',
    code: 'https://github.com/RonaldDM',
  },
] as const;

const placeholderIcons: Record<string, string> = {
  chart: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><polyline points="7 10 10 7 13 10 17 6"/></svg>`,
  monitor: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><rect x="15" y="6" width="4" height="6" rx="1"/></svg>`,
  radar: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="14" x2="12" y2="22" opacity="0"/></svg>`,
  mail: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
  calendar: `<svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/></svg>`,
};
---

<section class="projects section" id="projects">
  <div class="project-glow glow-1"></div>
  <div class="project-glow glow-2"></div>

  <div class="container">
    <!-- Section Header -->
    <div class="section-header reveal">
      <div class="section-label">
        <span class="label-line"></span>
        <span class="label-text">{t(lang, 'projects.label')}</span>
      </div>
      <h2 class="section-title">
        {t(lang, 'projects.title')}
        <span class="gradient-text">{t(lang, 'projects.title_highlight')}</span>
      </h2>
      <p class="section-description">{t(lang, 'projects.description')}</p>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs reveal" role="tablist">
      {
        (['all', 'fullstack', 'backend', 'mobile', 'desktop'] as const).map((f) => (
          <button
            class:list={['filter-btn', f === 'all' && 'active']}
            data-filter={f}
            role="tab"
            aria-selected={f === 'all' ? 'true' : 'false'}
          >
            {t(lang, `projects.filters.${f}`)}
          </button>
        ))
      }
    </div>

    <!-- Projects Grid -->
    <div class="projects-grid" id="projects-grid">
      {
        projects.map((project) => {
          const features: string[] = tArray(lang, `projects.${project.key}.features`);
          const hasImage = !project.imagePlaceholderIcon && 'image' in project;
          return (
            <article
              class="project-card glass reveal"
              data-category={project.category}
            >
              <!-- Card Image -->
              <div class="card-image">
                {project.imagePlaceholderIcon ? (
                  <div class="card-placeholder">
                    <Fragment set:html={placeholderIcons[project.imagePlaceholderIcon]} />
                  </div>
                ) : (
                  <img
                    src={(project as { image: string }).image}
                    alt={t(lang, `projects.${project.key}.name`)}
                    loading="lazy"
                  />
                )}
                <span class:list={['type-badge', `type-badge--${project.type}`]}>
                  {t(lang, `projects.badges.${project.type}`)}
                </span>
              </div>

              <!-- Card Body -->
              <div class="card-body">
                <div>
                  <h3 class="card-title">{t(lang, `projects.${project.key}.name`)}</h3>
                  <p class="card-subtitle">{t(lang, `projects.${project.key}.subtitle`)}</p>
                </div>

                <p class="card-description">{t(lang, `projects.${project.key}.description`)}</p>

                <ul class="card-features">
                  {features.slice(0, 3).map((f: string) => (
                    <li>
                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      {f}
                    </li>
                  ))}
                </ul>

                <div class="card-tech">
                  {project.tech.map((tech) => (
                    <span class="tech-dot">
                      <span class="dot" style={`background:${tech.color}`} />
                      {tech.name}
                    </span>
                  ))}
                </div>

                <div class="card-actions">
                  {project.demo && (
                    <a href={project.demo} target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      {t(lang, 'projects.cta_demo')}
                    </a>
                  )}
                  {project.isPrivate ? (
                    <span class="btn btn-outline btn-sm btn-disabled" aria-disabled="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                      {t(lang, 'projects.badges.private_code')}
                    </span>
                  ) : project.code && (
                    <a href={project.code} target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                      {t(lang, 'projects.cta_code')}
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Swipe counter (mobile only) -->
    <div class="projects-counter" aria-live="polite" aria-atomic="true">
      <span class="counter-current">1</span>
      <span class="counter-sep">/</span>
      <span class="counter-total">6</span>
    </div>
  </div>
</section>

<style>
  .projects {
    background: var(--color-dark);
    position: relative;
    overflow: hidden;
  }

  .project-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .glow-1 {
    width: 600px;
    height: 600px;
    background: rgba(13, 148, 136, 0.1);
    top: -10%;
    right: -10%;
    filter: blur(120px);
  }

  .glow-2 {
    width: 500px;
    height: 500px;
    background: rgba(139, 92, 246, 0.07);
    bottom: 0;
    left: -10%;
    filter: blur(120px);
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .label-line {
    width: 2rem;
    height: 2px;
    background: var(--color-primary);
  }

  .label-text {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 700;
    color: var(--color-light);
    margin-bottom: 0.75rem;
  }

  .section-description {
    color: var(--color-text-muted);
    font-size: 1rem;
    max-width: 600px;
  }

  /* Filter Tabs */
  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--color-dark-muted);
    background: transparent;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all var(--transition-base);
    font-family: inherit;
  }

  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .filter-btn.active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* Project Card */
  .project-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: all var(--transition-base);
  }

  .project-card:hover {
    border-color: rgba(13, 148, 136, 0.35);
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  /* Card Image */
  .card-image {
    position: relative;
    height: 180px;
    background: var(--color-dark);
    overflow: hidden;
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .project-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(13, 148, 136, 0.1), rgba(139, 92, 246, 0.08));
    color: var(--color-primary);
    opacity: 0.75;
    transition: opacity var(--transition-base);
  }

  .project-card:hover .card-placeholder {
    opacity: 1;
  }

  .type-badge {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 0.65rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    backdrop-filter: blur(8px);
  }

  .type-badge--professional {
    background: rgba(13, 148, 136, 0.2);
    border: 1px solid rgba(13, 148, 136, 0.4);
    color: #2dd4bf;
  }

  .type-badge--personal {
    background: rgba(139, 92, 246, 0.2);
    border: 1px solid rgba(139, 92, 246, 0.4);
    color: #a78bfa;
  }

  /* Card Body */
  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    flex: 1;
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-light);
    transition: color var(--transition-fast);
    line-height: 1.3;
    margin-bottom: 0.2rem;
  }

  .project-card:hover .card-title {
    color: var(--color-primary);
  }

  .card-subtitle {
    font-size: 0.77rem;
    color: var(--color-text-muted);
    opacity: 0.7;
  }

  .card-description {
    font-size: 0.83rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .card-features li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .card-features li svg {
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .tech-dot {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .tech-dot .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .card-actions {
    display: flex;
    gap: 0.625rem;
    padding-top: 0.875rem;
    border-top: 1px solid var(--color-dark-muted);
  }

  .btn-sm {
    padding: 0.45rem 0.875rem;
    font-size: 0.78rem;
    gap: 0.35rem;
  }

  .btn-disabled {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Counter — hidden on desktop, visible in mobile carousel */
  .projects-counter {
    display: none;
  }

  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    /* Filter tabs: single scrollable row */
    .filter-tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 0.375rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: 0.375rem;
      margin-bottom: 1.5rem;
    }

    .filter-tabs::-webkit-scrollbar {
      display: none;
    }

    .filter-btn {
      flex-shrink: 0;
      padding: 0.4rem 0.875rem;
      font-size: 0.8rem;
    }

    /* Swipe deck: transform grid into horizontal snap carousel */
    .projects-grid {
      display: flex !important;
      flex-wrap: nowrap;
      overflow-x: scroll;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      gap: 1rem;
      padding-bottom: 0.5rem;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .projects-grid::-webkit-scrollbar {
      display: none;
    }

    .project-card {
      flex: 0 0 85%;
      min-width: 0;
      scroll-snap-align: start;
    }

    .card-image {
      height: 165px;
    }

    .card-body {
      padding: 1rem 1.125rem;
      gap: 0.75rem;
    }

    .card-subtitle {
      display: none;
    }

    .card-features {
      display: none;
    }

    .card-description {
      -webkit-line-clamp: 3;
    }

    /* Single result: center the card instead of left-aligning it */
    .projects-grid.has-single {
      justify-content: center;
      overflow-x: hidden;
    }

    .projects-grid.has-single .project-card {
      scroll-snap-align: none;
    }

    /* Animated swipe counter */
    .projects-counter {
      display: flex;
      justify-content: center;
      align-items: baseline;
      gap: 0.4rem;
      margin-top: 1.25rem;
      font-variant-numeric: tabular-nums;
    }

    .counter-current {
      font-size: 1.375rem;
      font-weight: 700;
      color: var(--color-primary);
      line-height: 1;
      transition: opacity 150ms ease;
    }

    .counter-sep {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      opacity: 0.35;
    }

    .counter-total {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      opacity: 0.5;
      line-height: 1;
    }
  }

  @media (max-width: 480px) {
    .project-card {
      flex: 0 0 90%;
    }

    .card-image {
      height: 148px;
    }

    .card-title {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const grid = document.getElementById('projects-grid')!;
  const cards = grid.querySelectorAll<HTMLElement>('.project-card');
  const counterCurrent = document.querySelector<HTMLElement>('.counter-current');
  const counterTotal = document.querySelector<HTMLElement>('.counter-total');

  function getVisibleCards(): HTMLElement[] {
    return Array.from(cards).filter((c) => c.style.display !== 'none');
  }

  function updateCounter(): void {
    if (!counterCurrent || !counterTotal) return;
    const visible = getVisibleCards();
    counterTotal.textContent = String(visible.length);
    if (!visible.length) return;
    const first = visible[0];
    const cardWidth = first.offsetWidth + 16; // offsetWidth + gap (1rem)
    const idx = Math.min(Math.round(grid.scrollLeft / cardWidth), visible.length - 1);
    counterCurrent.textContent = String(Math.max(idx + 1, 1));
    // Toggle centered layout when only 1 card is visible
    grid.classList.toggle('has-single', visible.length === 1);
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter!;

      filterBtns.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');

      cards.forEach((card) => {
        const category = card.dataset.category!;
        const show = filter === 'all' || category === filter;
        card.style.display = show ? '' : 'none';
      });

      // Reset carousel to start and refresh counter
      grid.scrollTo({ left: 0, behavior: 'instant' });
      updateCounter();
    });
  });

  grid.addEventListener('scroll', updateCounter, { passive: true });
  updateCounter();
</script>
